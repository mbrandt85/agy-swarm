{
  "deterministic-formatting-and-linting": {
    "PostToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|write_file|edit_file|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/agy-lint-runner.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
